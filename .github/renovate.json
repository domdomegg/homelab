{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":disableDependencyDashboard"
    ],
    "enabledManagers": [
        "custom.regex",
        "github-actions"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": ["src/k8s/appDefinitions.ts", "src/k8s/backup.ts"],
            "matchStrings": ["('|\\\")(?<depName>[a-z0-9-/.]*?):(?<currentValue>[a-z0-9-/.]*?)@(?<currentDigest>sha256:[0-9a-f]+?)('|\\\")"],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "fileMatch": ["src/k8s/.*\\.ts$"],
            "matchStrings": ["renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\s+version: '(?<currentValue>[^']+)'"],
            "versioningTemplate": "helm"
        },
        {
            "customType": "regex",
            "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
            "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[a-z-]+: (?<currentValue>\\S+)"],
            "extractVersionTemplate": "^v?(?<version>.*)$"
        }
    ],
    "minimumReleaseAge": "7 days",
    "minimumReleaseAgeBehaviour": "timestamp-optional",
    "packageRules": [
        {
            "description": "Workflows run with AWS and cluster-admin credentials: pin actions to commit SHAs",
            "matchManagers": ["github-actions"],
            "pinDigests": true
        },
        {
            "description": "My own images: take updates immediately",
            "matchPackageNames": ["ghcr.io/domdomegg/**"],
            "minimumReleaseAge": null
        }
    ],
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}",
    "addLabels": ["dependencies"]
}